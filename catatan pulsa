<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Catatan Pulsa & Token Listrik</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen">

  <!-- Header -->
  <header class="bg-indigo-600 text-white shadow-md">
    <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <i class="fa-solid me-1 fa-bolt-lightning text-yellow-300 text-2xl"></i>
        <h1 class="text-xl font-bold tracking-wide">Pencatatan Pulsa & Token PLN</h1>
      </div>
      <span class="text-xs bg-indigo-500 text-indigo-100 px-3 py-1 rounded-full border border-indigo-400">Penyimpanan Lokal</span>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-6">

    <!-- Ringkasan Keuangan / Dashboard -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 border-l-4 border-l-rose-500">
        <div class="flex justify-between items-center">
          <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Belum Dibayar (Kasbon)</p>
            <h3 id="statBelumLunas" class="text-2xl font-bold text-rose-600 mt-1">Rp 0</h3>
          </div>
          <div class="w-10 h-10 rounded-full bg-rose-50 text-rose-500 flex items-center justify-center">
            <i class="fa-solid fa-clock text-lg"></i>
          </div>
        </div>
        <p id="countBelumLunas" class="text-xs text-slate-500 mt-2">0 transaksi terhutang</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 border-l-4 border-l-emerald-500">
        <div class="flex justify-between items-center">
          <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Sudah Dibayar (Lunas)</p>
            <h3 id="statLunas" class="text-2xl font-bold text-emerald-600 mt-1">Rp 0</h3>
          </div>
          <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-500 flex items-center justify-center">
            <i class="fa-solid fa-circle-check text-lg"></i>
          </div>
        </div>
        <p id="countLunas" class="text-xs text-slate-500 mt-2">0 transaksi selesai</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 border-l-4 border-l-indigo-500">
        <div class="flex justify-between items-center">
          <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Omset</p>
            <h3 id="statTotal" class="text-2xl font-bold text-indigo-600 mt-1">Rp 0</h3>
          </div>
          <div class="w-10 h-10 rounded-full bg-indigo-50 text-indigo-500 flex items-center justify-center">
            <i class="fa-solid fa-wallet text-lg"></i>
          </div>
        </div>
        <p id="countTotal" class="text-xs text-slate-500 mt-2">0 total transaksi</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Form Tambah Transaksi -->
      <div class="lg:col-span-1 bg-white rounded-xl shadow-sm border border-slate-200 p-5 h-fit">
        <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
          <i class="fa-solid fa-cart-plus text-indigo-600"></i>
          Tambah Transaksi Baru
        </h2>

        <form id="txForm" onsubmit="saveTransaction(event)" class="space-y-4">
          <input type="hidden" id="txId" />

          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Pelanggan *</label>
            <input type="text" id="nama" required placeholder="Contoh: Budi Santoso"
                   class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Jenis Layanan *</label>
            <select id="layanan" onchange="autoFillNominal(this.value)"
                    class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
              <option value="Token Listrik">Token Listrik (PLN)</option>
              <option value="Pulsa HP">Pulsa HP</option>
              <option value="Paket Data">Paket Data / Kuota</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">No. HP / ID PLN *</label>
            <input type="text" id="tujuan" required placeholder="0812xxx atau ID Meter 12 digit"
                   class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Nominal Produk *</label>
              <input type="number" id="nominal" required placeholder="50000" min="0" step="1000"
                     class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Harga Tagihan (Rp) *</label>
              <input type="number" id="harga" required placeholder="52000" min="0" step="1000"
                     class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Status Pembayaran *</label>
            <select id="statusBayar"
                    class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none font-semibold">
              <option value="Belum" class="text-rose-600 font-semibold">Belum Dibayar (Hutang)</option>
              <option value="Sudah" class="text-emerald-600 font-semibold">Sudah Dibayar (Lunas)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Catatan / No. SN / Token (Opsional)</label>
            <textarea id="catatan" rows="2" placeholder="Nomor SN / 20 digit kode token PLN"
                      class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
          </div>

          <div class="flex gap-2 pt-2">
            <button type="submit" id="btnSubmit"
                    class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg text-sm shadow-sm transition">
              <i class="fa-solid fa-save mr-1"></i> Simpan Transaksi
            </button>
            <button type="button" onclick="resetForm()" id="btnReset"
                    class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium px-3 py-2 rounded-lg text-sm transition">
              Batal
            </button>
          </div>
        </form>
      </div>

      <!-- Tabel Daftar Pelanggan & Transaksi -->
      <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-slate-200 p-5 flex flex-col">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
          <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-list-check text-indigo-600"></i>
            Daftar Transaksi
          </h2>

          <!-- Filter & Pencarian -->
          <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
            <select id="filterStatus" onchange="renderData()" class="px-3 py-1.5 text-xs border border-slate-300 rounded-lg bg-slate-50 focus:outline-none">
              <option value="semua">Semua Status</option>
              <option value="Belum">Belum Dibayar</option>
              <option value="Sudah">Sudah Dibayar</option>
            </select>

            <input type="text" id="searchInput" oninput="renderData()" placeholder="Cari nama / nomor..."
                   class="px-3 py-1.5 text-xs border border-slate-300 rounded-lg focus:outline-none w-full sm:w-40" />
          </div>
        </div>

        <!-- Tabel Container -->
        <div class="overflow-x-auto flex-1">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-slate-100 text-slate-600 border-b border-slate-200">
                <th class="p-3">Tanggal</th>
                <th class="p-3">Pelanggan</th>
                <th class="p-3">Layanan / No.</th>
                <th class="p-3">Nominal / Tagihan</th>
                <th class="p-3">Status</th>
                <th class="p-3 text-center">Aksi</th>
              </tr>
            </thead>
            <tbody id="tableBody" class="divide-y divide-slate-100">
              <!-- Data akan dirender dari JS -->
            </tbody>
          </table>
          <div id="emptyState" class="text-center py-10 text-slate-400 hidden">
            <i class="fa-solid fa-folder-open text-3xl mb-2"></i>
            <p>Belum ada data transaksi pencatatan.</p>
          </div>
        </div>
      </div>

    </div>
  </main>

  <script>
    const STORAGE_KEY = 'PELANGGAN_TOKEN_PULSA_DB';
    let transactions = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];

    function saveToStorage() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(transactions));
    }

    function formatRupiah(number) {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(number);
    }

    function formatDate(isoString) {
      const date = new Date(isoString);
      return date.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
    }

    function saveTransaction(e) {
      e.preventDefault();

      const id = document.getElementById('txId').value;
      const nama = document.getElementById('nama').value.trim();
      const layanan = document.getElementById('layanan').value;
      const tujuan = document.getElementById('tujuan').value.trim();
      const nominal = parseFloat(document.getElementById('nominal').value) || 0;
      const harga = parseFloat(document.getElementById('harga').value) || 0;
      const statusBayar = document.getElementById('statusBayar').value;
      const catatan = document.getElementById('catatan').value.trim();

      if (id) {
        // Update existing
        const index = transactions.findIndex(t => t.id === id);
        if (index !== -1) {
          transactions[index] = { ...transactions[index], nama, layanan, tujuan, nominal, harga, statusBayar, catatan };
        }
      } else {
        // Create new
        const newTx = {
          id: Date.now().toString(),
          date: new Date().toISOString(),
          nama,
          layanan,
          tujuan,
          nominal,
          harga,
          statusBayar,
          catatan
        };
        transactions.unshift(newTx);
      }

      saveToStorage();
      resetForm();
      renderData();
    }

    function toggleStatus(id) {
      const index = transactions.findIndex(t => t.id === id);
      if (index !== -1) {
        transactions[index].statusBayar = transactions[index].statusBayar === 'Sudah' ? 'Belum' : 'Sudah';
        saveToStorage();
        renderData();
      }
    }

    function editTransaction(id) {
      const tx = transactions.find(t => t.id === id);
      if (!tx) return;

      document.getElementById('txId').value = tx.id;
      document.getElementById('nama').value = tx.nama;
      document.getElementById('layanan').value = tx.layanan;
      document.getElementById('tujuan').value = tx.tujuan;
      document.getElementById('nominal').value = tx.nominal;
      document.getElementById('harga').value = tx.harga;
      document.getElementById('statusBayar').value = tx.statusBayar;
      document.getElementById('catatan').value = tx.catatan || '';

      document.getElementById('btnSubmit').innerHTML = '<i class="fa-solid fa-pen-to-square mr-1"></i> Update Transaksi';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function deleteTransaction(id) {
      if (confirm('Yakin ingin menghapus catatan transaksi ini?')) {
        transactions = transactions.filter(t => t.id !== id);
        saveToStorage();
        renderData();
      }
    }

    function resetForm() {
      document.getElementById('txId').value = '';
      document.getElementById('txForm').reset();
      document.getElementById('btnSubmit').innerHTML = '<i class="fa-solid fa-save mr-1"></i> Simpan Transaksi';
    }

    function renderData() {
      const tableBody = document.getElementById('tableBody');
      const emptyState = document.getElementById('emptyState');
      const filterStatus = document.getElementById('filterStatus').value;
      const searchQuery = document.getElementById('searchInput').value.toLowerCase();

      tableBody.innerHTML = '';

      let filtered = transactions.filter(item => {
        const matchesStatus = filterStatus === 'semua' || item.statusBayar === filterStatus;
        const matchesSearch = item.nama.toLowerCase().includes(searchQuery) || item.tujuan.toLowerCase().includes(searchQuery);
        return matchesStatus && matchesSearch;
      });

      if (filtered.length === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }

      filtered.forEach(item => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 border-b border-slate-100 transition';

        const isLunas = item.statusBayar === 'Sudah';

        tr.innerHTML = `
          <td class="p-3 text-slate-500 whitespace-nowrap">${formatDate(item.date)}</td>
          <td class="p-3">
            <div class="font-bold text-slate-800">${item.nama}</div>
            ${item.catatan ? `<div class="text-[10px] text-slate-500 italic mt-0.5">${item.catatan}</div>` : ''}
          </td>
          <td class="p-3 whitespace-nowrap">
            <span class="inline-block px-1.5 py-0.5 text-[10px] rounded font-medium ${item.layanan === 'Token Listrik' ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800'} mb-1">
              ${item.layanan}
            </span>
            <div class="font-mono text-slate-600">${item.tujuan}</div>
          </td>
          <td class="p-3 whitespace-nowrap">
            <div class="text-slate-500 text-[11px]">Nominal: ${formatRupiah(item.nominal)}</div>
            <div class="font-bold text-slate-800">Tagihan: ${formatRupiah(item.harga)}</div>
          </td>
          <td class="p-3 whitespace-nowrap">
            <button onclick="toggleStatus('${item.id}')"
                    title="Klik untuk mengubah status"
                    class="px-2.5 py-1 rounded-full text-[11px] font-semibold inline-flex items-center gap-1.5 cursor-pointer transition ${
                      isLunas ? 'bg-emerald-100 text-emerald-700 hover:bg-emerald-200' : 'bg-rose-100 text-rose-700 hover:bg-rose-200'
                    }">
              <i class="fa-solid ${isLunas ? 'fa-check' : 'fa-hourglass-half'}"></i>
              ${isLunas ? 'Sudah Dibayar' : 'Belum Dibayar'}
            </button>
          </td>
          <td class="p-3 text-center whitespace-nowrap">
            <button onclick="editTransaction('${item.id}')" class="text-indigo-600 hover:text-indigo-800 p-1 mx-0.5" title="Edit">
              <i class="fa-solid fa-pen"></i>
            </button>
            <button onclick="deleteTransaction('${item.id}')" class="text-rose-500 hover:text-rose-700 p-1 mx-0.5" title="Hapus">
              <i class="fa-solid fa-trash"></i>
            </button>
          </td>
        `;

        tableBody.appendChild(tr);
      });

      calculateDashboard();
    }

    function calculateDashboard() {
      let totalBelumLunas = 0;
      let countBelumLunas = 0;
      let totalLunas = 0;
      let countLunas = 0;

      transactions.forEach(item => {
        if (item.statusBayar === 'Belum') {
          totalBelumLunas += item.harga;
          countBelumLunas++;
        } else {
          totalLunas += item.harga;
          countLunas++;
        }
      });

      document.getElementById('statBelumLunas').innerText = formatRupiah(totalBelumLunas);
      document.getElementById('countBelumLunas').innerText = `${countBelumLunas} transaksi terhutang`;

      document.getElementById('statLunas').innerText = formatRupiah(totalLunas);
      document.getElementById('countLunas').innerText = `${countLunas} transaksi selesai`;

      document.getElementById('statTotal').innerText = formatRupiah(totalBelumLunas + totalLunas);
      document.getElementById('countTotal').innerText = `${transactions.length} total transaksi`;
    }

    // Inisialisasi awal
    renderData();
  </script>
</body>
</html>
